<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#1a0d05">
<title>Whetū Digital — digital tools for Aotearoa</title>
<meta name="description" content="Whetū Digital builds simple, beautiful digital tools for Aotearoa New Zealand. ARCLINE, Clarity, STLRentals, SALINA — products with mana.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg1:#0a0e1a;--bg2:#0f1424;
  --gold:#ffd34d;--gold2:#f5c557;--saffron:#f97316;--coral:#e8724a;
  --green:#3ddc97;--blue:#5db4ff;--purple:#a878ff;
  --text:#e6ecff;--text2:#9aa5c4;--muted:#5a6584;
  --card:#151b2d;--card2:#1c243a;--border:rgba(255,255,255,.08);--border2:rgba(255,255,255,.16);
  --serif:'Cormorant Garamond',serif;--sans:'Inter',sans-serif;--mono:'Geist Mono',monospace
}
html,body{min-height:100vh;background:var(--bg1);color:var(--text);font-family:var(--sans);font-size:16px;-webkit-tap-highlight-color:transparent;overflow-x:hidden}
body{background:linear-gradient(170deg,#0a0e1a 0%,#0f1424 45%,#151b2d 100%);position:relative}

.aurora{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(110px);opacity:.45;animation:orbDrift 22s ease-in-out infinite}
.orb1{width:720px;height:720px;background:radial-gradient(circle,rgba(255,211,77,.5),transparent 70%);top:-220px;left:-180px}
.orb2{width:580px;height:580px;background:radial-gradient(circle,rgba(168,120,255,.35),transparent 70%);top:40%;right:-160px;animation-delay:-7s}
.orb3{width:480px;height:480px;background:radial-gradient(circle,rgba(93,180,255,.3),transparent 70%);bottom:-100px;left:30%;animation-delay:-11s}
.orb4{width:380px;height:380px;background:radial-gradient(circle,rgba(249,115,22,.32),transparent 70%);bottom:18%;right:22%;animation-delay:-15s}
@keyframes orbDrift{0%,100%{transform:translateY(0) scale(1)}33%{transform:translateY(-50px) scale(1.06)}66%{transform:translateY(30px) scale(.96)}}

.grain{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.04;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");background-size:200px 200px;mix-blend-mode:overlay}

main{position:relative;z-index:2;max-width:1200px;margin:0 auto;padding:24px 28px 80px}

/* Nav */
nav{display:flex;align-items:center;justify-content:space-between;padding:18px 0 64px}
.nav-logo{font-family:var(--serif);font-size:24px;font-weight:700;background:linear-gradient(135deg,var(--gold),var(--saffron));-webkit-background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:.5px}
.nav-tag{font-family:var(--mono);font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--text2);margin-left:14px}
.nav-tag::before{content:"·";color:var(--gold);margin-right:14px}
.nav-cta{font-family:var(--mono);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);padding:9px 16px;border:1px solid var(--gold);border-radius:8px;text-decoration:none;transition:all .25s}
.nav-cta:hover{background:var(--gold);color:#1a0d05}

/* Hero */
.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:60px;align-items:center;padding:40px 0 80px}
.hero-left{position:relative}
.hero-eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:18px;display:inline-block;padding:6px 14px;background:rgba(255,211,77,.08);border:1px solid rgba(255,211,77,.25);border-radius:8px}
.hero-title{font-family:var(--serif);font-size:clamp(48px,7vw,84px);font-weight:600;line-height:1.05;margin-bottom:22px;letter-spacing:-1.5px}
.hero-title em{font-style:italic;background:linear-gradient(135deg,var(--gold),var(--saffron));-webkit-background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 0 30px rgba(255,211,77,.3))}
.hero-sub{font-size:19px;color:var(--text2);line-height:1.6;margin-bottom:32px;max-width:520px}
.hero-cta-row{display:flex;gap:14px;flex-wrap:wrap}
.btn-primary{display:inline-flex;align-items:center;gap:10px;padding:16px 28px;background:linear-gradient(135deg,var(--gold),var(--saffron));color:#1a0d05;text-decoration:none;border-radius:12px;font-weight:700;font-size:15px;box-shadow:0 14px 40px rgba(255,211,77,.35);transition:all .25s}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 50px rgba(255,211,77,.5)}
.btn-secondary{display:inline-flex;align-items:center;gap:10px;padding:16px 28px;background:var(--card);color:var(--text);text-decoration:none;border-radius:12px;border:1px solid var(--border2);font-weight:600;font-size:15px;transition:all .25s}
.btn-secondary:hover{border-color:var(--gold);color:var(--gold)}

.hero-right{position:relative;display:flex;align-items:center;justify-content:center}
.mascot-frame{position:relative;width:340px;height:340px;border-radius:24px;background:radial-gradient(circle at center,rgba(255,211,77,.15) 0%,rgba(168,120,255,.05) 60%,transparent 100%);display:flex;align-items:center;justify-content:center;animation:mascotFloat 8s ease-in-out infinite}
@keyframes mascotFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.mascot-svg{width:240px;height:240px;filter:drop-shadow(0 20px 40px rgba(255,211,77,.4))}
.mascot-frame::before{content:"";position:absolute;inset:-20px;border-radius:30px;background:linear-gradient(135deg,rgba(255,211,77,.2),rgba(168,120,255,.15));filter:blur(40px);z-index:-1;animation:mascotGlow 4s ease-in-out infinite alternate}
@keyframes mascotGlow{from{opacity:.5;transform:scale(.95)}to{opacity:1;transform:scale(1.05)}}

/* Section heading */
.sec-h{font-family:var(--mono);font-size:11px;letter-spacing:3.5px;text-transform:uppercase;color:var(--gold);margin-bottom:14px}
.sec-title{font-family:var(--serif);font-size:clamp(34px,4.5vw,52px);font-weight:600;line-height:1.1;margin-bottom:18px;letter-spacing:-.6px}
.sec-sub{font-size:17px;color:var(--text2);line-height:1.6;max-width:680px;margin-bottom:48px}

/* Products grid */
.products{padding:80px 0}
.product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:40px}
.product{position:relative;padding:30px 26px;background:var(--card);border:1px solid var(--border);border-radius:18px;text-decoration:none;color:var(--text);transition:all .35s cubic-bezier(.22,1,.36,1);overflow:hidden}
.product:hover{transform:translateY(-6px);background:var(--card2);border-color:var(--accent,var(--gold));box-shadow:0 24px 60px rgba(0,0,0,.4)}
.product::before{content:"";position:absolute;top:0;left:0;width:100%;height:3px;background:var(--accent,var(--gold));transform:scaleX(0);transform-origin:left;transition:transform .4s}
.product:hover::before{transform:scaleX(1)}
.product-icon{font-size:32px;margin-bottom:14px;display:inline-block;width:54px;height:54px;border-radius:12px;background:rgba(255,211,77,.1);display:flex;align-items:center;justify-content:center}
.product[data-tier="flagship"]{--accent:var(--gold)} .product[data-tier="flagship"] .product-icon{background:rgba(255,211,77,.15)}
.product[data-tier="live"]{--accent:var(--green)} .product[data-tier="live"] .product-icon{background:rgba(61,220,151,.15)}
.product[data-tier="soon"]{--accent:var(--purple)} .product[data-tier="soon"] .product-icon{background:rgba(168,120,255,.15)}
.product[data-tier="growing"]{--accent:var(--blue)} .product[data-tier="growing"] .product-icon{background:rgba(93,180,255,.15)}
.product-name{font-family:var(--serif);font-size:24px;font-weight:600;margin-bottom:6px}
.product-tag{font-family:var(--mono);font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--accent,var(--gold));margin-bottom:14px}
.product-desc{font-size:14px;color:var(--text2);line-height:1.55;margin-bottom:14px}
.product-meta{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:1px}

/* Philosophy section */
.philosophy{padding:100px 0 60px;text-align:center;max-width:760px;margin:0 auto}
.philosophy-quote{font-family:var(--serif);font-style:italic;font-size:clamp(28px,4vw,40px);line-height:1.4;color:var(--gold2);margin:24px 0}
.philosophy-quote::before,.philosophy-quote::after{content:"";display:inline-block;width:40px;height:2px;background:var(--gold);margin:0 14px;vertical-align:middle;opacity:.5}
.philosophy-attribution{font-family:var(--mono);font-size:11px;letter-spacing:3px;color:var(--text2);text-transform:uppercase;margin-top:16px}

/* Stats */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;padding:60px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin:40px 0}
.stat-cell{text-align:center;padding:14px 18px}
.stat-num{font-family:var(--serif);font-size:54px;font-weight:600;line-height:1;background:linear-gradient(135deg,var(--gold),var(--saffron));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8px}
.stat-label{font-family:var(--mono);font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:var(--text2)}

/* Footer-as-hero */
.footer-hero{margin-top:100px;padding:80px 28px;background:radial-gradient(ellipse at center,rgba(255,211,77,.12) 0%,transparent 70%);border-radius:28px;text-align:center;position:relative;overflow:hidden}
.footer-hero::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,211,77,.06),rgba(168,120,255,.04));pointer-events:none}
.footer-hero-title{font-family:var(--serif);font-size:clamp(38px,5.5vw,64px);font-weight:600;line-height:1.1;margin-bottom:18px;letter-spacing:-.8px}
.footer-hero-title em{font-style:italic;background:linear-gradient(135deg,var(--gold),var(--saffron));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.footer-hero-sub{font-size:18px;color:var(--text2);max-width:520px;margin:0 auto 32px;line-height:1.6}
.footer-meta{margin-top:60px;padding-top:36px;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase}
.footer-meta strong{color:var(--gold);font-weight:600}

/* Responsive */
@media(max-width:860px){
  .hero{grid-template-columns:1fr;gap:40px;padding:20px 0 60px}
  .hero-right{order:-1}
  .mascot-frame{width:240px;height:240px}
  .mascot-svg{width:170px;height:170px}
  main{padding:16px 18px 60px}
}

/* Entrance animations */
.fade-in{opacity:0;transform:translateY(20px);animation:fadeIn .8s cubic-bezier(.22,1,.36,1) forwards}
.fade-in:nth-child(1){animation-delay:.1s}
.fade-in:nth-child(2){animation-delay:.25s}
.fade-in:nth-child(3){animation-delay:.4s}
.fade-in:nth-child(4){animation-delay:.55s}
@keyframes fadeIn{to{opacity:1;transform:translateY(0)}}
</style>
</head>
<body>

<div class="aurora" aria-hidden="true">
  <div class="orb orb1"></div><div class="orb orb2"></div>
  <div class="orb orb3"></div><div class="orb orb4"></div>
</div>
<div class="grain" aria-hidden="true"></div>

<main>
  <nav>
    <div>
      <span class="nav-logo">WHETŪ DIGITAL</span>
      <span class="nav-tag">Aotearoa</span>
    </div>
    <a class="nav-cta" href="mailto:hello@whetudigital.co.nz">Get in touch</a>
  </nav>

  <section class="hero">
    <div class="hero-left">
      <div class="hero-eyebrow fade-in">★ Digital tools with mana ★</div>
      <h1 class="hero-title fade-in">Beautiful tools<br>for <em>modern Aotearoa</em>.</h1>
      <p class="hero-sub fade-in">Whetū Digital builds simple, gorgeous software for New Zealanders. Property tools, family dashboards, electrical compliance, event invitations — all crafted with care, all designed to feel effortless.</p>
      <div class="hero-cta-row fade-in">
        <a href="#products" class="btn-primary">See our products →</a>
        <a href="mailto:hello@whetudigital.co.nz" class="btn-secondary">Work with us</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="mascot-frame">
        <!-- NOVA mascot SVG - star-shaped friendly character -->
        <svg class="mascot-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="bodyGrad" cx="40%" cy="35%" r="65%">
              <stop offset="0%" stop-color="#fff3d6"/>
              <stop offset="40%" stop-color="#ffd34d"/>
              <stop offset="85%" stop-color="#f97316"/>
              <stop offset="100%" stop-color="#b4470c"/>
            </radialGradient>
            <radialGradient id="cheekGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ff8a65" stop-opacity="0.7"/>
              <stop offset="100%" stop-color="#ff8a65" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <!-- aurora halo -->
          <ellipse cx="100" cy="100" rx="92" ry="86" fill="#ffd34d" opacity="0.12" filter="blur(8px)"/>
          <!-- star body -->
          <path d="M 100,18 L 124,72 L 182,80 L 138,118 L 152,176 L 100,148 L 48,176 L 62,118 L 18,80 L 76,72 Z" fill="url(#bodyGrad)" stroke="#b4470c" stroke-width="1.5"/>
          <!-- cheeks -->
          <circle cx="78" cy="115" r="10" fill="url(#cheekGrad)"/>
          <circle cx="122" cy="115" r="10" fill="url(#cheekGrad)"/>
          <!-- eyes -->
          <ellipse cx="84" cy="100" rx="5.5" ry="7" fill="#2a1408"/>
          <ellipse cx="116" cy="100" rx="5.5" ry="7" fill="#2a1408"/>
          <circle cx="86" cy="97" r="2" fill="#fff"/>
          <circle cx="118" cy="97" r="2" fill="#fff"/>
          <!-- smile -->
          <path d="M 84,125 Q 100,140 116,125" stroke="#2a1408" stroke-width="3" fill="none" stroke-linecap="round"/>
          <!-- WHETU chest star -->
          <path d="M 100,84 L 103,90 L 109,91 L 105,95 L 106,101 L 100,98 L 94,101 L 95,95 L 91,91 L 97,90 Z" fill="#fff3d6" opacity="0.9"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="products" id="products">
    <div class="sec-h">Our products</div>
    <h2 class="sec-title">Six tools, one philosophy.</h2>
    <p class="sec-sub">Everything we build is private-first, gorgeous, and made for Aotearoa. From household budgets to trade compliance, each product solves one job beautifully.</p>

    <div class="product-grid">
      <a class="product" data-tier="flagship" href="#">
        <div class="product-icon">⚡</div>
        <div class="product-name">ARCLINE</div>
        <div class="product-tag">Sept 2026 · NZ electrical</div>
        <div class="product-desc">EWRB-native compliance & vault. CoC / ESC / RoI generated in seconds, 7-year archive, sparkie-first design.</div>
        <div class="product-meta">$49 / mo · Beta launching Sept</div>
      </a>

      <a class="product" data-tier="live" href="#">
        <div class="product-icon">💜</div>
        <div class="product-name">Clarity</div>
        <div class="product-tag">Live · household</div>
        <div class="product-desc">A calm household dashboard for budgets, kids, calendar. Private to your family, beautiful by default.</div>
        <div class="product-meta">$0 personal · client tier varies</div>
      </a>

      <a class="product" data-tier="growing" href="#">
        <div class="product-icon">🏠</div>
        <div class="product-name">STLRentals</div>
        <div class="product-tag">Live · NZ landlords</div>
        <div class="product-desc">Property income tracker. Rent ledger, maintenance log, inspection scheduler, tax-ready summaries.</div>
        <div class="product-meta">$19 / mo · multi-tenant Supabase</div>
      </a>

      <a class="product" data-tier="soon" href="#">
        <div class="product-icon">🌸</div>
        <div class="product-name">Salina · Invitation Suite</div>
        <div class="product-tag">Coming soon · families</div>
        <div class="product-desc">Beautiful private invitation pages for cultural ceremonies. RSVP collection, elderly-friendly tap-to-call, multilingual.</div>
        <div class="product-meta">$299 / event · one-time</div>
      </a>

      <a class="product" data-tier="growing" href="#">
        <div class="product-icon">🎪</div>
        <div class="product-name">EventSpace Pro</div>
        <div class="product-tag">Live · event hire</div>
        <div class="product-desc">Marquee & equipment booking dashboards for hire companies. Layout planner, client portal, payments.</div>
        <div class="product-meta">$29 / mo · NZ event hire</div>
      </a>

      <a class="product" data-tier="soon" href="#">
        <div class="product-icon">🤖</div>
        <div class="product-name">AI GURU Hosted</div>
        <div class="product-tag">Coming · personal AI workspace</div>
        <div class="product-desc">Your own AI mission queue, knowledge graph, multi-provider routing, NOVA desktop companion.</div>
        <div class="product-meta">$29 / mo · public beta soon</div>
      </a>
    </div>
  </section>

  <section class="philosophy">
    <div class="sec-h">Our philosophy</div>
    <div class="philosophy-quote">Beautiful tools don't shout. They serve quietly, fit life perfectly, and never make you feel small.</div>
    <div class="philosophy-attribution">— The Whetū Way</div>
  </section>

  <section class="stats">
    <div class="stat-cell">
      <div class="stat-num">6</div>
      <div class="stat-label">Products live</div>
    </div>
    <div class="stat-cell">
      <div class="stat-num">100%</div>
      <div class="stat-label">Privacy-first</div>
    </div>
    <div class="stat-cell">
      <div class="stat-num">$0</div>
      <div class="stat-label">Hidden fees</div>
    </div>
    <div class="stat-cell">
      <div class="stat-num">∞</div>
      <div class="stat-label">Made with care</div>
    </div>
  </section>

  <section class="footer-hero">
    <div class="sec-h">Get in touch</div>
    <h2 class="footer-hero-title">Building something for <em>your</em> Aotearoa?</h2>
    <p class="footer-hero-sub">Whether you're a tradie, a family, an event hire company, or anyone with a small problem worth solving beautifully — we'd love to hear from you.</p>
    <a class="btn-primary" href="mailto:hello@whetudigital.co.nz">Say kia ora →</a>

    <div class="footer-meta">
      <span><strong>WHETŪ DIGITAL</strong> · Aotearoa New Zealand</span>
      <span>hello@whetudigital.co.nz</span>
      <span>© 2026 · Built with care</span>
    </div>
  </section>
</main>

<script>
// Subtle parallax on mascot when mouse moves
const mascot = document.querySelector('.mascot-frame');
if (mascot) {
  document.addEventListener('mousemove', (e) => {
    const x = (e.clientX / window.innerWidth - 0.5) * 12;
    const y = (e.clientY / window.innerHeight - 0.5) * 12;
    mascot.style.transform = `translate(${x}px, ${y}px)`;
  });
}
</script>
</body>
</html>
